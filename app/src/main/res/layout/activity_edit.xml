<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.falcon.snap.ui.BlockImageView
                android:id="@+id/edit_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/black"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <!-- Only shown when the image has more than one text block -->
            <LinearLayout
                android:id="@+id/block_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/block_prev"
                    style="@style/IconButton.Small"
                    android:contentDescription="@string/cd_previous"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/brand_red" />

                <TextView
                    android:id="@+id/block_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/block_next"
                    style="@style/IconButton.Small"
                    android:contentDescription="@string/cd_next"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/brand_red" />
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_original_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_original"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:maxLines="5"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/clear_original"
                    style="@style/IconButton.Small"
                    android:contentDescription="@string/cd_clear"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_translated_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_text_box"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_translated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="5"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/clear_translated"
                    style="@style/IconButton.Small"
                    android:contentDescription="@string/cd_clear"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lang_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lang_source"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_text_box"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/lang_swap"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/button_height"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_swap"
                    android:padding="9dp"
                    android:src="@drawable/ic_swap"
                    app:tint="@color/brand_red" />

                <TextView
                    android:id="@+id/lang_target"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_text_box"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply"
                style="@style/Widget.Snap.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="16dp"
                android:text="@string/btn_apply" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
